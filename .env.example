# Strava OAuth
# Get these from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret

# Auth.js
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret

# Supabase
# Get these from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email notifications (Resend — https://resend.com)
RESEND_API_KEY=re_your_api_key
# Verified sender address in Resend (e.g. noreply@yourdomain.com)
# Use "noreply@resend.dev" for testing on free plan
RESEND_FROM_EMAIL=Bike Condition <noreply@yourdomain.com>
# Master switch for email notifications
NOTIFICATIONS_ENABLED=true
# Optional: comma-separated user ids (users.id) that can see and use email
# notifications. Needed while Resend is in sandbox mode, where mail can only be
# delivered to the account owner's address. Remove once a domain is verified.
NOTIFICATIONS_USER_ALLOWLIST=

# Strava Webhooks (for automatic activity sync)
# STRAVA_WEBHOOK_VERIFY_TOKEN: any secret string you choose — used when registering the webhook
# Generate with: openssl rand -base64 32
STRAVA_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
# Your deployed app URL (no trailing slash) — required for webhook registration script
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# Subscription ID returned by setup-strava-webhook.ts — used for deregistration
STRAVA_WEBHOOK_SUBSCRIPTION_ID=your_subscription_id
